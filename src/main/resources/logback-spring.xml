<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/bus-route-backend.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/bus-route-backend.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="GPS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/gps.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/gps.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <logger name="org.springframework" level="${SPRING_LOG_LEVEL:-WARN}"/>
    <logger name="org.springframework.data" level="${DATA_LOG_LEVEL:-WARN}"/>
    <logger name="org.springframework.r2dbc" level="${SQL_LOG_LEVEL:-WARN}"/>
    <logger name="io.r2dbc" level="${SQL_LOG_LEVEL:-WARN}"/>
    <logger name="biz.ugur.busroutebackend" level="${LOG_LEVEL:-INFO}"/>

    <logger name="biz.ugur.busroutebackend.transport.infrastructure.debug.PipelineTracer" additivity="true">
        <appender-ref ref="GPS_FILE"/>
    </logger>
    <logger name="biz.ugur.busroutebackend.transport.infrastructure.prediction" additivity="true">
        <appender-ref ref="GPS_FILE"/>
    </logger>
    <logger name="biz.ugur.busroutebackend.transport.infrastructure.services.VehicleDirectionDetectionServiceImpl" additivity="true">
        <appender-ref ref="GPS_FILE"/>
    </logger>
    <logger name="biz.ugur.busroutebackend.transport.application.usecase.pipeline" additivity="true">
        <appender-ref ref="GPS_FILE"/>
    </logger>

</configuration>
