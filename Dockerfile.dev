FROM openjdk:24-jdk-slim

LABEL maintainer="Bus Route Team"
LABEL version="1.0.0-dev"
LABEL description="Bus Route Backend - Development Container"

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    htop \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY pom.xml ./
COPY .mvn .mvn
COPY mvnw ./

RUN chmod +x mvnw

RUN ./mvnw dependency:go-offline -B

COPY src ./src


EXPOSE 8080 5005

ENV SPRING_PROFILES_ACTIVE=dev
ENV DB_HOST=db-route
ENV REDIS_HOST=redis-route
ENV GPS_API_BASE_URL=http://wiremock:8080/mock/gps/api
ENV BUS_INFO_API_BASE_URL=http://wiremock:8080/mock/bus-info
ENV JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC -XX:+UseStringDeduplication"
ENV DEBUG_OPTS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]

