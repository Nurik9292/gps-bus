# Template for production/staging deployment. Copy to .env and fill in real secrets.
# The .env file is gitignored — never commit real credentials.
#
# REQUIRED (no fallback in application.yml, app won't start without them):
#   DB_PASSWORD, JWT_SECRET, ADMIN_DEFAULT_PASSWORD
# RECOMMENDED (safe dev defaults exist, override for prod):
#   DB_HOST, REDIS_HOST, SERVER_HOST, storage paths, mail, payment *_USER/*_PASS

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bus_route_db
DB_USERNAME=bus_route_user
# REQUIRED
DB_PASSWORD=<change-me>

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== External GPS provider =====
GPS_API_TOKEN=<change-me>
GPS_TUGDK_TOKEN=<change-me>

# ===== Server =====
SERVER_PORT=8080
SERVER_HOST=<your-public-domain-or-ip>
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# ===== CORS =====
# Comma-separated whitelist of allowed origins (exact match).
# Dev default (in application.yml): localhost:3000, localhost:5173, localhost:8080.
# Prod MUST override with real admin/client domains.
CORS_ALLOWED_ORIGINS=https://admin.ugur.biz,https://duralga.ulgam.biz
CORS_ALLOW_CREDENTIALS=true

# ===== Admin bootstrap (used only to seed first admin on empty DB) =====
ADMIN_DEFAULT_USERNAME=admin
# REQUIRED (min 12 chars, strong password)
ADMIN_DEFAULT_PASSWORD=<change-me>

# ===== Mail =====
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=
MAIL_FROM=

# ===== JWT =====
# REQUIRED (min 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=<generate-at-least-32-char-random-string>
# Optional per-audience override:
# JWT_ADMIN_SECRET=
# JWT_CLIENT_SECRET=
# Client token lifetimes (ISO-8601 duration; defaults P31D / P90D).
# Refresh must be longer than access. Used by mobile client + integration tokens.
# JWT_CLIENT_ACCESS_EXPIRATION=P31D
# JWT_CLIENT_REFRESH_EXPIRATION=P90D

# ===== Payment providers (sv_epg) =====
# Rysgal Bank (https://epg.rysgalbank.tm/epg/rest)
PAYMENT_RYSGAL_ENABLED=false
PAYMENT_RYSGAL_URL=https://epg.rysgalbank.tm/epg/rest
PAYMENT_RYSGAL_USER=<supplied-by-bank>
PAYMENT_RYSGAL_PASS=<supplied-by-bank>
PAYMENT_RYSGAL_TERMINAL_ID=<supplied-by-bank>
PAYMENT_RYSGAL_PID=<supplied-by-bank>

# Senagat Bank (https://epg.senagatbank.com.tm/epg/rest)
PAYMENT_SENAGAT_ENABLED=false
PAYMENT_SENAGAT_URL=https://epg.senagatbank.com.tm/epg/rest
PAYMENT_SENAGAT_USER=<supplied-by-bank>
PAYMENT_SENAGAT_PASS=<supplied-by-bank>

# Not yet contracted
PAYMENT_BKB_ENABLED=false
PAYMENT_HALK_ENABLED=false

# ===== GPS API alerts =====
GPS_ALERT_ENABLED=false
GPS_ALERT_RECIPIENTS=             # comma-separated; e.g. ops@example.com,admin@example.com

# ===== Off-route alerts =====
OFF_ROUTE_ALERT_ENABLED=false
# Если пусто — используются GPS_ALERT_RECIPIENTS:
# OFF_ROUTE_ALERT_RECIPIENTS=
